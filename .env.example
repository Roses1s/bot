# =============================================================================
# Odoo CRM — Environment Variables
# Скопируйте в .env и заполните: cp .env.example .env
# =============================================================================

# --- PostgreSQL ---
POSTGRES_DB=odoo
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS
POSTGRES_PORT=5432

# --- Odoo ---
# Мастер-пароль для управления БД через UI (/web/database/manager)
ODOO_ADMIN_PASSWD=CHANGE_ME_ADMIN_PASSWD
ODOO_PROXY_MODE=True

# --- Домен и SSL ---
DOMAIN=crm.example.com
EMAIL=admin@example.com
# Для staging Let's Encrypt (тесты без лимитов)
# STAGING=1

# --- Бэкапы ---
BACKUP_CRON=0 3 * * *              # каждый день в 03:00
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=./backups

# S3 (опционально) — если пусто, бэкап только локально
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1

# Telegram уведомления (опционально)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Мониторинг ---
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA
